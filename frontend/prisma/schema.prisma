// Carnivore_Meal MVP - Prisma Schema
// Defines all data models for the carnivore meal planning application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum SubscriptionTier {
  FREE
  BASIC  
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum NutritionalProfile {
  STRICT        // Only meat, salt, water
  LEANER        // Lean cuts focus
  WITH_DAIRY    // Includes dairy products
  BUDGET        // Budget-friendly options
}

enum MealPlanStatus {
  DRAFT
  ACCEPTED
  ARCHIVED
}

enum IntegrationStatus {
  PREPARED
  SENT
  FAILED
}

// Core Models
model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String            @map("password_hash")
  ageConfirmed      Boolean           @default(false) @map("age_confirmed")
  consentStatus     String            @default("pending") @map("consent_status")
  subscriptionTier  SubscriptionTier  @default(FREE) @map("subscription_tier")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  stripeCustomerId  String?           @map("stripe_customer_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  onboardingResponses    OnboardingResponse[]
  preferenceProfile      PreferenceProfile?
  mealPlans             MealPlan[]
  shoppingLists         ShoppingList[]
  subscriptions         Subscription[]
  feedbackEntries       FeedbackEntry[]
  adaptationLogs        AdaptationLog[]
  consentRecords        ConsentRecord[]
  auditLogs             AuditLog[]

  @@map("users")
}

model OnboardingResponse {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  responses   Json     // Stores all 24+ questionnaire responses
  completedAt DateTime @default(now()) @map("completed_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_responses")
}

model PreferenceProfile {
  id                String              @id @default(cuid())
  userId            String              @unique @map("user_id")
  allowedMeats      String[]            @map("allowed_meats") // e.g., ["beef", "chicken", "fish"]
  exclusions        String[]            // e.g., ["pork", "lamb"]  
  prepTimePreference Int               @default(30) @map("prep_time_preference") // minutes
  budgetRange       String?             @map("budget_range") // e.g., "low", "medium", "high"
  cookingSkill      String?             @default("beginner") @map("cooking_skill")
  nutritionalProfile NutritionalProfile @default(STRICT) @map("nutritional_profile")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preference_profiles")
}

model Meal {
  id            String @id @default(cuid())
  name          String
  description   String?
  ingredients   Json   // Structured ingredient list with quantities
  portions      Int    @default(1)
  macroProfile  Json   // Protein, fat, calories per serving
  prepEffortTag String @default("easy") @map("prep_effort_tag") // easy, medium, advanced
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations - meals can be in many meal plans
  mealPlanDays  MealPlanDay[]

  @@map("meals")
}

model MealPlan {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  startDate         DateTime        @map("start_date")
  endDate           DateTime        @map("end_date")
  constraintsSummary String?        @map("constraints_summary")
  status            MealPlanStatus  @default(DRAFT)
  regenerationCount Json           @default("{}") @map("regeneration_count") // Track regen per day
  history           Json           @default("[]") // Previous versions/changes
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days          MealPlanDay[]   // Individual days in the plan
  shoppingLists ShoppingList[]

  @@map("meal_plans")
}

// Junction table for meal plan days and their meals
model MealPlanDay {
  id         String   @id @default(cuid())
  mealPlanId String   @map("meal_plan_id")
  dayIndex   Int      @map("day_index") // 0-based index (0 = first day)
  mealId     String   @map("meal_id")
  mealType   String   @default("main") @map("meal_type") // breakfast, lunch, dinner, snack
  accepted   Boolean  @default(true) // User can reject individual meals

  // Relations  
  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meal     Meal     @relation(fields: [mealId], references: [id])

  @@unique([mealPlanId, dayIndex, mealType])
  @@map("meal_plan_days")
}

model ShoppingList {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  mealPlanId     String   @map("meal_plan_id")
  items          Json     // Aggregated ingredients with qty/unit/section
  exportFormats  String[] @default(["csv"]) @map("export_formats")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlan           MealPlan                    @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  integrationRequests GroceryIntegrationRequest[]

  @@map("shopping_lists")
}

model GroceryIntegrationRequest {
  id             String            @id @default(cuid())
  userId         String            @map("user_id") 
  shoppingListId String            @map("shopping_list_id")
  service        String            // "instacart", future: "amazon_fresh", etc.
  payloadMeta    Json              @map("payload_meta") // Service-specific data
  status         IntegrationStatus @default(PREPARED)
  error          String?           // Error message if failed
  createdAt      DateTime          @default(now()) @map("created_at")

  // Relations
  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@map("grocery_integration_requests")
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  tier         SubscriptionTier
  billingCycle String             @default("monthly") @map("billing_cycle")
  priceId      String?            @map("price_id") // Stripe price ID
  status       SubscriptionStatus @default(ACTIVE)
  stripeSubId  String?            @unique @map("stripe_subscription_id")
  startedAt    DateTime           @default(now()) @map("started_at")
  renewsAt     DateTime?          @map("renews_at")
  canceledAt   DateTime?          @map("canceled_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model FeedbackEntry {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  mealId    String?   @map("meal_id") // Optional - general feedback vs meal-specific
  note      String?
  rating    Int?      // 1-5 scale
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback_entries")
}

model AdaptationLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  date       DateTime
  category   String   // "symptoms", "energy", "measurements", etc.
  severity   String?  // For symptoms: "mild", "moderate", "severe"
  level      String?  // For energy: "low", "moderate", "high"
  value      Float?   // For measurements (weight, etc.)
  unit       String?  // "lbs", "kg", "inches", etc.
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("adaptation_logs")
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // "terms", "privacy", "age_verification", etc.
  version   String   // Version of the consent document
  timestamp DateTime @default(now())
  source    String   // Where consent was given: "registration", "profile_update", etc.

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String   // "meal_plan_generated", "subscription_upgraded", etc.
  metadata  Json     @default("{}") // Additional context
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
